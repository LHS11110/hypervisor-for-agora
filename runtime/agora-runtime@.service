[Unit]
Description=Agora canvas runtime %i
After=local-fs.target agora-runtime-network@%i.service
BindsTo=agora-runtime-network@%i.service
ConditionPathExists=/var/lib/agora-runtime/canvases/%i/guest.raw

[Service]
Type=exec
User=agora-vmm
Group=agora-vmm
SupplementaryGroups=kvm
RootDirectory=/usr/local/lib/agora-hypervisor/root
MountAPIVFS=yes
BindPaths=/var/lib/agora-runtime/canvases/%i:/data
BindPaths=/dev/kvm
BindPaths=/dev/net/tun
BindReadOnlyPaths=/usr/local/lib/agora-hypervisor/cloud-hypervisor
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
NetworkNamespacePath=/run/netns/agora-runtime-%i
PrivateIPC=yes
PrivatePIDs=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/data
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @debug @module @raw-io @clock @cpu-emulation @obsolete
MemoryDenyWriteExecute=yes
IPAddressDeny=any
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
LimitCORE=0
LimitNOFILE=256
LimitFSIZE=25769803776
MemoryMax=1536M
MemorySwapMax=0
CPUQuota=200%
TasksMax=64
IOWeight=10
IOReadBandwidthMax=/var/lib/agora-runtime 52428800
IOWriteBandwidthMax=/var/lib/agora-runtime 52428800
IOReadIOPSMax=/var/lib/agora-runtime 1000
IOWriteIOPSMax=/var/lib/agora-runtime 1000
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=15s
Restart=no
StandardInput=null
StandardOutput=journal
StandardError=journal
Environment=AGORA_VM_CPUS=boot=1 AGORA_VM_MEMORY=size=1024M AGORA_VM_TEMPLATE=small
EnvironmentFile=-/var/lib/agora-runtime/launch/%i.env
ExecStart=/usr/local/lib/agora-hypervisor/cloud-hypervisor --api-socket /data/api.sock --kernel /firmware/vmlinuz --cmdline "root=/dev/vda rw init=/usr/local/sbin/agora-init agora.resources=${AGORA_VM_TEMPLATE}" --cpus ${AGORA_VM_CPUS} --memory ${AGORA_VM_MEMORY} --disk path=/data/guest.raw,image_type=raw,backing_files=off --net tap=tap0,mac=02:00:00:00:00:02,num_queues=2 --vsock cid=3,socket=/data/vsock --console off --serial null --seccomp true --landlock --landlock-rules path=/sys/class/net/tap0/tun_flags,access=r
