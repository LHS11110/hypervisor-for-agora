#!/usr/bin/env bash
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run as root.' >&2; exit 1; }
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
[[ -f "$ROOT/runtime/guest/workspace-crdt.cjs" ]] || { echo 'Build runtime/workspace with pnpm before installing.' >&2; exit 1; }
STATE=/var/lib/agora-runtime
[[ -x /usr/local/lib/agora-hypervisor/cloud-hypervisor ]] || { echo 'Install the managed hypervisor first.' >&2; exit 1; }
[[ -f "$STATE/base.raw" && -f "$STATE/vmlinuz" ]] || { echo 'Run runtime/prepare-guest first.' >&2; exit 1; }
getent passwd agora-vmm >/dev/null
for dependency in ip iptables iptables-restore sysctl; do command -v "$dependency" >/dev/null; done
mkdir -p /run/netns
# /run is volatile. Populate the Spring bind source during early boot, before
# Docker restores containers. Waiting for the manager from Docker would cycle
# through the egress service, which itself starts after Docker.
install -m 0644 "$ROOT/runtime/agora-runtime.tmpfiles.conf" /etc/tmpfiles.d/agora-runtime.conf
systemd-tmpfiles --create /etc/tmpfiles.d/agora-runtime.conf
install -m 0644 "$ROOT/runtime/network.py" /usr/local/lib/agora-hypervisor/runtime-network.py
install -m 0644 "$ROOT/runtime/agora-runtime-egress.service" /etc/systemd/system/agora-runtime-egress.service
install -m 0644 "$ROOT/runtime/agora-runtime-network@.service" /etc/systemd/system/agora-runtime-network@.service
if [[ ! -f /etc/agora-runtime-network.json ]]; then
  printf '{"blocked_ipv4": [], "public_https_ipv4": []}\n' > /etc/agora-runtime-network.json
  chmod 0600 /etc/agora-runtime-network.json
fi
printf 'net.ipv4.ip_forward = 1\n' > /etc/sysctl.d/90-agora-runtime-network.conf

mkdir -p "$STATE/canvases"
chmod 0700 "$STATE" "$STATE/canvases"
install -m 0644 "$STATE/vmlinuz" /usr/local/lib/agora-hypervisor/root/firmware/vmlinuz
install -m 0644 "$ROOT/runtime/runtime_options.py" /usr/local/lib/agora-hypervisor/runtime_options.py
install -d -m 0755 /usr/local/lib/agora-hypervisor/guest
install -m 0644 "$ROOT/runtime/guest/runner.py" "$ROOT/runtime/guest/terminal.py" "$ROOT/runtime/guest/notebook.py" "$ROOT/runtime/guest/notebook_worker.py" "$ROOT/runtime/guest/package_manager.py" "$ROOT/runtime/guest/workspace.py" "$ROOT/runtime/guest/workspace-crdt.cjs" /usr/local/lib/agora-hypervisor/guest/
install -m 0644 "$ROOT/runtime/agent_update.py" /usr/local/lib/agora-hypervisor/runtime-agent-update.py
install -m 0644 "$ROOT/runtime/agora-runtime-agent@.service" /etc/systemd/system/agora-runtime-agent@.service
install -m 0644 "$ROOT/runtime/manager.py" /usr/local/lib/agora-hypervisor/runtime-manager.py
install -m 0644 "$ROOT/runtime/agora-runtime@.service" /etc/systemd/system/agora-runtime@.service
install -m 0644 "$ROOT/runtime/agora-runtime-manager.service" /etc/systemd/system/agora-runtime-manager.service
systemd-analyze verify /etc/systemd/system/agora-runtime@.service /etc/systemd/system/agora-runtime-manager.service /etc/systemd/system/agora-runtime-network@.service /etc/systemd/system/agora-runtime-egress.service
systemctl daemon-reload
systemctl enable --now agora-runtime-egress.service agora-runtime-manager.service
systemctl is-active --quiet agora-runtime-manager.service
echo 'Runtime manager is running. Start Agora with Project Orchestra --runtime.'
