[Unit]
Description=Agora isolated Cloud Hypervisor
Requires=agora-hypervisor.socket
After=local-fs.target agora-hypervisor.socket
ConditionPathExists=/var/lib/agora-hypervisor/guest.raw
ConditionPathExists=/var/lib/agora-hypervisor/seed.img

[Service]
Type=exec
User=agora-vmm
Group=agora-vmm
SupplementaryGroups=kvm
RootDirectory=/usr/local/lib/agora-hypervisor/root
MountAPIVFS=yes
StateDirectory=agora-hypervisor
StateDirectoryMode=0700
Sockets=agora-hypervisor.socket
BindPaths=/var/lib/agora-hypervisor:/data
BindPaths=/dev/kvm
BindReadOnlyPaths=/usr/local/lib/agora-hypervisor/cloud-hypervisor
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
PrivateNetwork=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/data
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @debug @module @raw-io @clock @cpu-emulation @obsolete
MemoryDenyWriteExecute=yes
IPAddressDeny=any
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
LimitCORE=0
LimitNOFILE=256
LimitFSIZE=10737418240
MemoryMax=12G
MemorySwapMax=0
CPUQuota=200%
TasksMax=64
IOWeight=10
IOReadBandwidthMax=/var/lib/agora-hypervisor 52428800
IOWriteBandwidthMax=/var/lib/agora-hypervisor 52428800
IOReadIOPSMax=/var/lib/agora-hypervisor 1000
IOWriteIOPSMax=/var/lib/agora-hypervisor 1000
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=15s
SendSIGKILL=yes
Restart=no
LogNamespace=agora-hypervisor
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/lib/agora-hypervisor/cloud-hypervisor --api-socket fd=3 --firmware /firmware/CLOUDHV.fd --cpus boot=2 --memory size=1024M --disk path=/data/guest.raw,image_type=raw,backing_files=off path=/data/seed.img,image_type=raw,backing_files=off,readonly=on --console off --serial null --seccomp true --landlock

[Install]
WantedBy=multi-user.target
